{
  "permissions": {
    "deny": ["Edit(results/**)", "Write(results/**)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/format-edited.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/check-on-stop.sh" }]
      }
    ]
  }
}
